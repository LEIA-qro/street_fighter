# Copia este archivo a terraform.tfvars y rellena con TUS valores.
# terraform.tfvars esta git-ignorado; el .example (solo placeholders) si se commitea.

# Obligatorias -------------------------------------------------------------------------
tailscale_auth_key = "tskey-auth-XXXXXXXXXXXX-YYYYYYYYYYYYYYYYYYYYYYYY" # settings/keys, reusable+ephemeral
owner              = "tu-usuario-github"

# Opcionales (defaults sanos) ----------------------------------------------------------
# wandb_api_key = "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX" # wandb.ai/authorize; vacio = sin W&B
# instance_type = "t3.small"
# region        = "us-west-2"
# create_bucket = true
# wandb_project = "leia-sf2-es"

# El default de repo_url es SSH y exige deploy key en la VPS. Sin deploy key, usa la
# variante https con un fine-grained token de solo lectura (ver README, seccion clonado):
# repo_url    = "https://oauth2:github_pat_XXXXXXXX@github.com/LEIA-qro/street_fighter.git"
# repo_branch = "stage0-metrics-and-semantics"
